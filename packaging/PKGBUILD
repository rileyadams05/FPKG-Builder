pkgname=fpkg-builder
pkgver=0.1.0
pkgrel=1
pkgdesc='Build fPKGs from Itemzflow game dumps'
arch=('x86_64')
url='https://github.com/rileyadams05/FPKG-Builder'
license=('custom:LibOrbisPkg-LGPL-3.0')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'librsvg')
options=('!strip')

package() {
  install -Dm755 "$startdir/src-tauri/target/release/fpkg-builder" "$pkgdir/usr/bin/fpkg-builder"
  install -d "$pkgdir/usr/lib/fpkg-builder/resources/engine"
  cp -a "$startdir/src-tauri/resources/engine/." "$pkgdir/usr/lib/fpkg-builder/resources/engine/"
  install -Dm644 "$startdir/src/assets/mark.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/fpkg-builder.svg"
  install -Dm644 "$startdir/packaging/fpkg-builder.desktop" "$pkgdir/usr/share/applications/fpkg-builder.desktop"
  install -Dm644 "$startdir/THIRD_PARTY_NOTICES.md" "$pkgdir/usr/share/licenses/fpkg-builder/THIRD_PARTY_NOTICES.md"
  install -Dm644 "$startdir/src-tauri/resources/LibOrbisPkg-LICENSE.txt" "$pkgdir/usr/share/licenses/fpkg-builder/LibOrbisPkg-LICENSE.txt"
  install -Dm644 "$startdir/src-tauri/resources/THIRD_PARTY_DEPENDENCY_LICENSES.md" "$pkgdir/usr/share/licenses/fpkg-builder/THIRD_PARTY_DEPENDENCY_LICENSES.md"
  install -d "$pkgdir/usr/share/licenses/fpkg-builder/third-party"
  cp -a "$startdir/src-tauri/resources/licenses/." "$pkgdir/usr/share/licenses/fpkg-builder/third-party/"
}
